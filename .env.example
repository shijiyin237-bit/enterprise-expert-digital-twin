# ==============================================================================
# 专家数字孪生系统中台 - 环境变量模板 (.env.example)
# 使用方法：复制本文件为 .env，并填入你的真实 SiliconFlow 密钥
# ==============================================================================

# 1. 算力网关配置（必填）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
BASE_URL=https://api.siliconflow.cn/v1

# 2. 身份映射配置（ETL 炼油厂与生成引擎的核心锚点）
CLIENT_NAME=买家
EXPERT_NAME=客服

# 3. 暂存语料路径（一键启动时会自动嗅探，首次可留空）
LATEST_STAGING_FILE=

# 4. 全局性能与算力风控参数
LLM_TIMEOUT=60
